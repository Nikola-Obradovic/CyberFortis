{
  "name": "cyberfortis",
  "main": "worker.js",
  "compatibility_date": "2026-02-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker rewrites HTML/robots/sitemap per domain; hashed bundles skip it.
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
